rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- User Rules ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'displayName']) &&
               data.uid == request.auth.uid &&
               data.displayName is string && data.displayName.size() <= 100;
      }
      
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Users can see other farmers' public profiles
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'location', 'farmerType', 'crops', 'language']);
    }

    // --- Diagnostic Rules ---
    match /diagnostics/{diagnosticId} {
      function isValidDiagnostic(data) {
        return data.userId == request.auth.uid &&
               data.cropType is string && data.cropType.size() <= 100;
      }
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidDiagnostic(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- Marketplace Rules ---
    match /marketplace/{itemId} {
      function isValidMarketplaceItem(data) {
        return data.sellerId == request.auth.uid &&
               data.name is string && data.name.size() <= 200 &&
               data.price is number && data.price >= 0;
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidMarketplaceItem(request.resource.data);
      allow update: if isSignedIn() && resource.data.sellerId == request.auth.uid && isValidMarketplaceItem(request.resource.data);
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // --- Chat Messages Rules ---
    match /chats/{chatId}/messages/{messageId} {
       function isValidMessage(data) {
        return data.senderId == request.auth.uid &&
               data.text is string && data.text.size() <= 2000;
      }
      // Simple logic: users can read messages if they are sender or receiver
      // In a real app we might have a chat meta doc with participants
      allow read: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && isValidMessage(request.resource.data);
    }
  }
}
