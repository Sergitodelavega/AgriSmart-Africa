{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information for farmers",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "location": { "type": "string" },
        "farmerType": { "type": "string", "enum": ["smallholder", "commercial", "hobbyist"] },
        "crops": { "type": "array", "items": { "type": "string" } },
        "language": { "type": "string", "enum": ["fr", "en"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName"]
    },
    "Diagnostic": {
      "title": "Diagnostic",
      "description": "AI-generated diagnostic for crop health",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "cropType": { "type": "string" },
        "issueDetected": { "type": "string" },
        "recommendations": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "MarketplaceItem": {
      "title": "MarketplaceItem",
      "description": "Item for sale in the marketplace",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "location": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message sent in a chat room",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/diagnostics/{diagnosticId}": {
      "schema": "Diagnostic",
      "description": "Crop diagnostics"
    },
    "/marketplace/{itemId}": {
      "schema": "MarketplaceItem",
      "description": "Items in marketplace"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Chat messages"
    }
  }
}
